{
  "apiVersion": "takosumi.com/v2.5",
  "kind": "Repository",
  "install": {
    "modules": {
      ".": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            }
          },
          {
            "name": "app_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "空欄の場合は利用可能なWorker URLを使います。",
              "en": "Uses an available Worker URL when omitted."
            },
            "placeholder": "https://office.example.com"
          },
          {
            "name": "takosumi_accounts_issuer_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts発行者",
              "en": "Takosumi Accounts issuer"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_client_id",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosumi Accountsクライアント",
              "en": "Takosumi Accounts client"
            },
            "advanced": true
          },
          {
            "name": "worker_release_tag",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Workerリリース",
              "en": "Worker release"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Worker URL",
              "en": "Worker URL"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_sha256",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Worker SHA-256",
              "en": "Worker SHA-256"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts URL",
              "en": "Takosumi Accounts URL"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_redirect_uri",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "登録済みコールバックURI",
              "en": "Registered callback URI"
            },
            "advanced": true
          },
          {
            "name": "enable_cloudflare_resources",
            "source": {
              "kind": "user"
            },
            "type": "boolean",
            "label": {
              "ja": "Cloudflareリソースを作成",
              "en": "Create Cloudflare resources"
            },
            "helper": {
              "ja": "Cloudflareへ配置するときは、この設定と「Officeを起動」を有効にします。適用前に作成内容を確認できます。",
              "en": "Enable this and Deploy Office for a Cloudflare deployment. Review the resource plan before applying."
            },
            "advanced": true
          },
          {
            "name": "enable_cloudflare_worker_script",
            "source": {
              "kind": "user"
            },
            "type": "boolean",
            "label": {
              "ja": "Officeを起動",
              "en": "Deploy Office"
            },
            "helper": {
              "ja": "OfficeのWorkerを配置します。「Cloudflareリソースを作成」も有効にしてください。",
              "en": "Deploy the Office Worker. Also enable Create Cloudflare resources."
            },
            "advanced": true
          },
          {
            "name": "object_storage_workspace_id",
            "source": {
              "kind": "workspace_id"
            },
            "type": "string",
            "label": {
              "ja": "現在のWorkspace",
              "en": "Current Workspace"
            }
          },
          {
            "name": "app_capsule_id",
            "source": {
              "kind": "capsule_id"
            },
            "type": "string",
            "label": {
              "ja": "現在のアプリ",
              "en": "Current app"
            }
          },
          {
            "name": "takosumi_control_api_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "advanced": false,
            "label": {
              "ja": "Takosumi API URL",
              "en": "Takosumi API URL"
            },
            "helper": {
              "ja": "TakosumiのStorage接続を使う場合は必須です。空欄は既存のself-host用Storage設定を維持します。AccountsやStorageのURLからは推測しません。",
              "en": "Required for Takosumi-managed Storage. Leave empty only for existing standalone Storage configuration. Not inferred from Accounts or Storage."
            },
            "placeholder": "https://takosumi.example.com"
          }
        ],
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "app_url"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback",
            "scopes": [
              "openid",
              "profile",
              "email",
              "capsules:read"
            ],
            "deliver": {
              "variables": {
                "accountsUrl": "takosumi_accounts_url",
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id",
                "redirectUri": "takosumi_accounts_redirect_uri"
              }
            }
          },
          {
            "kind": "interface.consume",
            "key": "storage",
            "interface": {
              "type": "storage.object",
              "version": "1"
            },
            "permissions": [
              "storage.object.list",
              "storage.object.read",
              "storage.object.write",
              "storage.object.delete"
            ],
            "delivery": {
              "type": "oauth2.app-data.v1"
            }
          }
        ],
        "interfaces": [
          {
            "key": "launcher",
            "name": "takos-office.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Takos Office"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "ui.open"
                ],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          },
          {
            "key": "mcp",
            "name": "takos-office.mcp",
            "spec": {
              "type": "mcp.server",
              "version": "2025-11-25",
              "document": {
                "transport": "streamable-http",
                "display": {
                  "title": "Takos Office"
                }
              },
              "inputs": {
                "endpoint": {
                  "source": "output",
                  "outputName": "mcp_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace",
                "resourceUriInput": "endpoint"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "mcp.invoke"
                ],
                "delivery": {
                  "type": "oauth2"
                }
              }
            ]
          }
        ]
      },
      "deploy/takoform": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            }
          },
          {
            "name": "worker_release_tag",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Workerリリース",
              "en": "Worker release"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Worker URL",
              "en": "Worker URL"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_sha256",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Worker SHA-256",
              "en": "Worker SHA-256"
            },
            "advanced": true
          }
        ]
      },
      "deploy/takoform-v1": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            }
          },
          {
            "name": "app_capsule_id",
            "source": {
              "kind": "capsule_id"
            },
            "type": "string",
            "label": {
              "ja": "現在のアプリ",
              "en": "Current app"
            }
          },
          {
            "name": "app_workspace_id",
            "source": {
              "kind": "workspace_id"
            },
            "type": "string",
            "label": {
              "ja": "現在の保存先",
              "en": "Current storage coordinate"
            }
          },
          {
            "name": "takosumi_control_api_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": true,
            "label": {
              "ja": "Takosumi API URL",
              "en": "Takosumi API URL"
            },
            "helper": {
              "ja": "このOfficeのStorage接続を管理するTakosumiのHTTPS URL。",
              "en": "HTTPS URL of the Takosumi managing this Office Storage connection."
            }
          }
        ],
        "requires": [
          {
            "kind": "secret.generated",
            "bytes": 32,
            "encoding": "hex",
            "deliver": {
              "bindings": {
                "value": "APP_SESSION_SECRET"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback",
            "scopes": [
              "openid",
              "profile",
              "email",
              "capsules:read"
            ],
            "deliver": {
              "bindings": {
                "issuerUrl": "OIDC_ISSUER_URL",
                "clientId": "OIDC_CLIENT_ID",
                "ownerSubject": "OIDC_OWNER_SUB",
                "redirectUri": "OIDC_REDIRECT_URI"
              }
            }
          },
          {
            "kind": "interface.consume",
            "key": "storage",
            "interface": {
              "type": "storage.object",
              "version": "1"
            },
            "permissions": [
              "storage.object.list",
              "storage.object.read",
              "storage.object.write",
              "storage.object.delete"
            ],
            "delivery": {
              "type": "oauth2.app-data.v1"
            }
          }
        ],
        "sourceBuild": {
          "commands": [
            {
              "argv": [
                "bun",
                "install",
                "--frozen-lockfile"
              ]
            },
            {
              "argv": [
                "bun",
                "run",
                "build"
              ]
            },
            {
              "argv": [
                "bun",
                "scripts/prepare-takoform-v1-source.ts"
              ]
            }
          ],
          "outputs": [
            "deploy/takoform-v1/.generated/office-worker.js"
          ]
        },
        "interfaces": [
          {
            "key": "launcher",
            "name": "takos-office.launcher",
            "spec": {
              "type": "interface.ui.surface",
              "version": "1",
              "document": {
                "launcher": true,
                "display": {
                  "title": "Takos Office"
                }
              },
              "inputs": {
                "url": {
                  "source": "output",
                  "outputName": "launch_url",
                  "outputType": "url"
                }
              },
              "access": {
                "visibility": "workspace"
              }
            },
            "bindingRequests": [
              {
                "key": "installer",
                "subject": {
                  "source": "installing_principal"
                },
                "permissions": [
                  "ui.open"
                ],
                "delivery": {
                  "type": "none"
                }
              }
            ]
          }
        ]
      }
    }
  }
}
