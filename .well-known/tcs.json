{
  "schemaVersion": "tcs.repo/v1",
  "id": "takos-office",
  "modulePath": ".",
  "kind": "worker",
  "surface": "service",
  "provider": "cloudflare",
  "category": "productivity",
  "suggestedName": "office",
  "name": {
    "ja": "Takos Office",
    "en": "Takos Office"
  },
  "description": {
    "ja": "docs / slide / sheet をまとめて公開します。",
    "en": "Deploys docs, slide, and sheet as one office app."
  },
  "badge": {
    "ja": "追加候補",
    "en": "Installable"
  },
  "iconUrl": "app/docs/public/icons/docs.svg",
  "inputs": [
    {
      "name": "project_name",
      "type": "string",
      "required": true,
      "defaultValue": "service-name",
      "label": { "ja": "サービス名", "en": "Service name" }
    },
    {
      "name": "worker_name",
      "type": "string",
      "format": "subdomain",
      "required": true,
      "defaultValue": "service-name",
      "label": { "ja": "公開URLの名前", "en": "Public URL name" }
    },
    {
      "name": "app_url",
      "type": "string",
      "format": "url",
      "advanced": true,
      "label": { "ja": "独自URL", "en": "Custom URL" }
    },
    {
      "name": "cloudflare_route_pattern",
      "type": "string",
      "advanced": true,
      "label": { "ja": "Cloudflare route", "en": "Cloudflare route" }
    }
  ],
  "installExperience": {
    "projections": [
      { "kind": "service_name", "variable": "project_name" },
      {
        "kind": "public_endpoint",
        "variables": {
          "subdomain": "worker_name",
          "url": "app_url",
          "routePattern": "cloudflare_route_pattern"
        },
        "baseDomain": "app.takos.jp"
      },
      {
        "kind": "oidc_client",
        "variables": {
          "issuerUrl": "takosumi_accounts_issuer_url",
          "clientId": "takosumi_accounts_client_id"
        },
        "callbackPath": "/api/auth/callback"
      }
    ]
  }
}
